  "inbounds": [
    {
      "tag": "socks-in",
      "port": 10808,
      "protocol": "socks",
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "fakedns",
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": false
      },
      "settings": {
        "udp": true,
        "ip": "127.0.0.1"
      },
      "streamSettings": {
        "sockopt": {
          "tcpKeepAliveIdle": 60,
          "tcpKeepAliveInterval": 30
        }
      }
    },
    {
      "tag": "http-in",
      "port": 10809,
      "protocol": "http",
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "fakedns",
          "http",
          "tls"
        ],
        "routeOnly": false
      }
    },
    {
      "tag": "tls-decrypt-h11",
      "listen": "127.0.0.1",
      "port": 4431,
      "protocol": "dokodemo-door",
      "settings": {
        "network": "tcp",
        "port": 443,
        "followRedirect": true
      },
      "streamSettings": {
        "security": "tls",
        "tlsSettings": {
          "alpn": [
            "http/1.1"
          ],
          "certificates": [
            {
              "usage": "issue",
              "certificate": [
                "__CA_CERTIFICATE__"
              ],
              "key": [
                "__CA_PRIVATE_KEY__"
              ]
            }
          ]
        }
      }
    },
    {
      "tag": "tls-decrypt-h2",
      "listen": "127.0.0.1",
      "port": 4432,
      "protocol": "dokodemo-door",
      "settings": {
        "network": "tcp",
        "port": 443,
        "followRedirect": true
      },
      "streamSettings": {
        "security": "tls",
        "tlsSettings": {
          "alpn": [
            "h2",
            "http/1.1"
          ],
          "certificates": [
            {
              "usage": "issue",
              "certificate": [
                "__CA_CERTIFICATE__"
              ],
              "key": [
                "__CA_PRIVATE_KEY__"
              ]
            }
          ]
        }
      }
    }
  ],
