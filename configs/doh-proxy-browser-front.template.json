          "domain:instagram.com",
          "domain:cdninstagram.com",
          "domain:facebook.com",
          "domain:fbcdn.net",
          "domain:fb.com",
          "domain:fbsbx.com",
          "domain:facebook.net",
          "domain:fb.me",
          "domain:threads.net",
          "domain:meta.com",
          "domain:messenger.com",
          "domain:whatsapp.com",
          "domain:whatsapp.net",
          "domain:wa.me",
          "domain:threads.com",
          "domain:ig.me",
          "domain:igcdn.com",
          "domain:fbcdn.com",
          "domain:fbsbx.net",
          "domain:fb.watch",
          "domain:fb.gg",
          "domain:m.me",
          "domain:oculus.com"
        ],
        "timeoutMs": 6000
      },
      {
        "address": "fakedns",
        "domains": [
          "domain:ir",
          "geosite:private",
          "geosite:category-ir",
          "geosite:xai",
          "geosite:openai",
          "geosite:google-deepmind",
          "geosite:anthropic",
          "geosite:github",
          "geosite:microsoft",
          "geosite:golang",
          "geosite:python",
          "geosite:rust",
          "full:challenges.cloudflare.com"
        ],
        "skipFallback": true
      },
      {
        "address": "fakedns",
        "domains": [
          "domain:google.com",
          "domain:gstatic.com",
          "domain:googleapis.com",
          "domain:googleusercontent.com",
          "domain:gmail.com",
          "domain:googlemail.com",
          "domain:gvt1.com",
          "domain:gvt2.com",
          "domain:recaptcha.net",
          "domain:ampproject.org",
          "domain:translate.goog",
          "domain:blogger.com",
          "domain:appspot.com"
        ],
        "skipFallback": true
      },
      {
        "tag": "doh-cf",
        "address": "https://cloudflare-dns.com/dns-query",
        "timeoutMs": 5000
      },
      {
        "tag": "doh-ip4",
        "address": "https://1.1.1.1/dns-query",
        "timeoutMs": 5000
      },
      {
        "tag": "doh-ip6",
        "address": "https://[2606:4700:4700::1111]/dns-query",
        "timeoutMs": 5000
      },
      {
        "tag": "doh-gg",
        "address": "https://8.8.8.8/dns-query",
        "timeoutMs": 5000
      },
