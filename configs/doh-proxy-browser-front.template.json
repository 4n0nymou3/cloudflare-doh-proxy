{
  "remarks": "🛡️ DoH Proxy Pro + Browser Front",
  "version": {
    "min": "26.10.29"
  },
  "log": {
    "loglevel": "warning",
    "dnsLog": false,
    "access": "none"
  },
  "policy": {
    "levels": {
      "0": {
        "handshake": 6,
        "connIdle": 300,
        "uplinkOnly": 2,
        "downlinkOnly": 4
      },
      "1": {
        "handshake": 6,
        "connIdle": 15,
        "uplinkOnly": 1,
        "downlinkOnly": 1
      }
    }
  },
