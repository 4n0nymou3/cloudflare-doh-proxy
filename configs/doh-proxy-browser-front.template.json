  "burstObservatory": {
    "subjectSelector": [
      "tf-"
    ],
    "pingConfig": {
      "destination": "https://www.youtube.com/generate_204",
      "connectivity": "",
      "interval": "30s",
      "sampling": 2,
      "timeout": "14s",
      "httpMethod": "GET"
    }
  },
  "routing": {
    "domainStrategy": "IPOnDemand",
    "balancers": [
