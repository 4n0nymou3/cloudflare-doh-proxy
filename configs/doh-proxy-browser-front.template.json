      "geosite:category-ads-all": "#3",
      "cloudflare-dns.com": "challenges.cloudflare.com",
      "${workerHost}": "challenges.cloudflare.com",
      "dns.redirect": [
        "1.1.1.1",
        "1.0.0.1"
      ]
    },
    "servers": [
      {
        "tag": "doh-proxy",
        "address": "${workerUrl}",
        "timeoutMs": 8000
      },
      {
        "tag": "fronted-dns",
        "address": "h2c://1.1.1.1/dns-query",
