{
  "remarks": "🛡️ DoH Proxy Pro + Fragment",
  "version": {
    "min": "26.10.29"
  },
  "log": {
    "loglevel": "warning"
  },
  "dns": {
    "hosts": {
      "dns.google": [
        "8.8.8.8",
        "8.8.4.4"
      ],
      "cloudflare-dns.com": [
        "cloudflare.com"
      ],
      "${workerHost}": "challenges.cloudflare.com"
    },
    "servers": [
      {
        "address": "${workerUrl}",
        "tag": "remote-dns",
        "timeoutMs": 8000
      },
      {
        "address": "fakedns",
        "domains": [
          "full:cloudflare.com"
        ],
        "skipFallback": false
      },
      {
        "address": "https://dns.google/dns-query",
        "tag": "remote-dns"
      },
      {
        "address": "https://cloudflare-dns.com/dns-query",
        "tag": "remote-dns"
      },
      {
        "address": "8.8.8.8",
        "domains": [
          "full:cloudflare.com"
        ],
        "skipFallback": false
      }
    ],
    "queryStrategy": "UseSystem",
    "enableParallelQuery": true,
    "tag": "dns"
  },
  "inbounds": [
    {
      "tag": "socks",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true,
        "ip": "127.0.0.1"
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic",
          "fakedns"
        ],
        "routeOnly": true
      }
    },
    {
      "tag": "http",
      "listen": "127.0.0.1",
      "port": 10809,
      "protocol": "http",
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic",
          "fakedns"
        ],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "UseIP",
          "happyEyeballs": {
            "tryDelayMs": 250,
            "prioritizeIPv6": false,
            "interleave": 2,
            "maxConcurrentTry": 4
          }
        },
        "finalmask": {
          "tcp": [
            {
              "type": "fragment",
              "settings": {
                "packets": "tlshello",
                "lengths": [
                  "100-200"
                ],
                "delays": [
                  "0"
                ]
              }
            }
          ],
          "udp": [
            {
              "type": "noise",
              "settings": {
                "reset": "30-60",
                "noise": [
                  {
                    "type": "exp",
                    "packet": "<b 0x123401000001000000000000076578616d706c6503636f6d0000010001>",
                    "delay": "0"
                  },
                  {
                    "rand": "40-70",
                    "randRange": "0-255",
                    "delay": "0"
                  },
                  {
                    "rand": "40-70",
                    "randRange": "0-255",
                    "delay": "0"
                  },
                  {
                    "rand": "40-70",
                    "randRange": "0-255",
                    "delay": "0"
                  },
                  {
                    "rand": "40-70",
                    "randRange": "0-255",
                    "delay": "0"
                  }
                ]
              }
            }
          ]
        }
      },
      "tag": "proxy"
    },
    {
      "tag": "dns-out",
      "protocol": "dns",
      "settings": {
        "rules": [
          {
            "action": "hijack"
          }
        ]
      }
    },
    {
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "UseIP",
          "happyEyeballs": {
            "tryDelayMs": 250,
            "prioritizeIPv6": false,
            "interleave": 2,
            "maxConcurrentTry": 4
          }
        }
      },
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "settings": {
        "response": {
          "type": "http"
        }
      },
      "tag": "block"
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "inboundTag": [
          "tun",
          "socks",
          "http"
        ],
        "port": 53,
        "outboundTag": "dns-out"
      },
      {
        "inboundTag": [
          "remote-dns"
        ],
        "outboundTag": "proxy"
      },
      {
        "inboundTag": [
          "dns"
        ],
        "outboundTag": "direct"
      },
      {
        "domain": [
          "geosite:private"
        ],
        "outboundTag": "direct"
      },
      {
        "ip": [
          "10.10.34.34/24",
          "2001:4188:2:600:10:10:34:34/112"
        ],
        "outboundTag": "block"
      },
      {
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "direct"
      },
      {
        "network": "tcp,udp",
        "outboundTag": "proxy"
      }
    ]
  },
  "policy": {
    "levels": {
      "0": {
        "handshake": 4
      }
    },
    "system": {
      "statsOutboundUplink": true,
      "statsOutboundDownlink": true
    }
  },
  "stats": {},
  "fakedns": [
    {
      "ipPool": "198.18.0.0/15",
      "poolSize": 32768
    },
    {
      "ipPool": "2001:2::/48",
      "poolSize": 32768
    }
  ]
}
