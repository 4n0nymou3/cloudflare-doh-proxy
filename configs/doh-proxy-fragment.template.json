{
  "remarks": "🛡️ DoH Proxy Pro + Fragment",
  "version": {
    "min": "26.10.29"
  },
  "log": {
    "loglevel": "warning"
  },
  "policy": {
    "levels": {
      "0": {
        "handshake": 6
      },
      "1": {
        "handshake": 6,
        "connIdle": 6
      }
    },
    "system": {
      "statsOutboundUplink": true,
      "statsOutboundDownlink": true
    }
  },
  "dns": {
    "hosts": {
      "geosite:category-ads-all": "#3",
      "dns.google": [
        "8.8.8.8",
        "8.8.4.4"
      ],
      "cloudflare-dns.com": [
        "cloudflare.com"
      ],
      "dns.redirect": [
        "1.1.1.1",
        "1.0.0.1"
      ],
      "${workerHost}": "challenges.cloudflare.com"
    },
    "servers": [
      {
        "tag": "doh-proxy",
        "address": "${workerUrl}",
        "timeoutMs": 5000
      },
      {
        "address": "https://dns.google/dns-query",
        "tag": "doh-proxy"
      },
      {
        "address": "https://cloudflare-dns.com/dns-query",
        "tag": "doh-proxy"
      },
      {
        "address": "fakedns",
        "domains": [
          "full:cloudflare.com",
          "full:challenges.cloudflare.com"
        ],
        "skipFallback": false
      },
      {
        "tag": "local-dns",
        "address": "localhost",
        "domains": [
          "domain:ir",
          "geosite:private",
          "geosite:category-ir"
        ],
        "skipFallback": true,
        "finalQuery": true,
        "timeoutMs": 5000
      },
      {
        "tag": "fronted-dns",
        "address": "h2c://1.1.1.1/dns-query",
        "domains": [
          "regexp:.*"
        ],
        "skipFallback": false,
        "timeoutMs": 6000
      }
    ],
    "queryStrategy": "UseSystem",
    "enableParallelQuery": false,
    "serveStale": true,
    "tag": "dns"
  },
  "inbounds": [
    {
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "mixed",
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic",
          "fakedns"
        ],
        "routeOnly": true
      },
      "settings": {
        "auth": "noauth",
        "udp": true,
        "ip": "127.0.0.1"
      }
    },
    {
      "tag": "loop-in",
      "listen": "127.0.0.1",
      "port": 10810,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": false
      }
    }
  ],
  "outbounds": [
    {
      "tag": "tf-v4-mid",
      "protocol": "freedom",
      "streamSettings": {
        "finalmask": {
          "tcp": [
            {
              "type": "fragment",
              "settings": {
                "packets": "tlshello",
                "lengths": [
                  "40-90",
                  "10-30"
                ],
                "delays": [
                  "0"
                ],
                "maxSplit": "0"
              }
            }
          ]
        },
        "sockopt": {
          "domainStrategy": "UseIP",
          "happyEyeballs": {
            "tryDelayMs": 250,
            "prioritizeIPv6": false,
            "interleave": 2,
            "maxConcurrentTry": 4
          }
        }
      }
    },
    {
      "tag": "tf-v4-big",
      "protocol": "freedom",
      "streamSettings": {
        "finalmask": {
          "tcp": [
            {
              "type": "fragment",
              "settings": {
                "packets": "tlshello",
                "lengths": [
                  "40-90",
                  "100-200"
                ],
                "delays": [
                  "0"
                ],
                "maxSplit": "0"
              }
            }
          ]
        },
        "sockopt": {
          "domainStrategy": "UseIP",
          "happyEyeballs": {
            "tryDelayMs": 250,
            "prioritizeIPv6": false,
            "interleave": 2,
            "maxConcurrentTry": 4
          }
        }
      }
    },
    {
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "UseIP",
          "happyEyeballs": {
            "tryDelayMs": 250,
            "prioritizeIPv6": false,
            "interleave": 2,
            "maxConcurrentTry": 4
          }
        }
      },
      "tag": "direct"
    },
    {
      "tag": "tls-repack-dns",
      "protocol": "freedom",
      "settings": {
        "redirect": "dns.redirect:443"
      },
      "streamSettings": {
        "security": "tls",
        "tlsSettings": {
          "serverName": "www.microsoft.com",
          "verifyPeerCertByName": "fromMitM,www.microsoft.com,www.google.com,dns.google,cloudflare-dns.com,one.one.one.one",
          "alpn": [
            "fromMitM"
          ],
          "fingerprint": "chrome"
        },
        "sockopt": {
          "domainStrategy": "ForceIP",
          "happyEyeballs": {
            "tryDelayMs": 300,
            "prioritizeIPv6": false,
            "interleave": 2,
            "maxConcurrentTry": 20
          }
        }
      }
    },
    {
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "UseIP",
          "happyEyeballs": {
            "tryDelayMs": 250,
            "prioritizeIPv6": false,
            "interleave": 2,
            "maxConcurrentTry": 4
          }
        },
        "finalmask": {
          "udp": [
            {
              "type": "noise",
              "settings": {
                "reset": "30-60",
                "noise": [
                  {
                    "type": "exp",
                    "packet": "<b 0x123401000001000000000000076578616d706c6503636f6d0000010001>",
                    "delay": "0"
                  },
                  {
                    "rand": "40-70",
                    "randRange": "0-255",
                    "delay": "0"
                  },
                  {
                    "rand": "40-70",
                    "randRange": "0-255",
                    "delay": "0"
                  },
                  {
                    "rand": "40-70",
                    "randRange": "0-255",
                    "delay": "0"
                  },
                  {
                    "rand": "40-70",
                    "randRange": "0-255",
                    "delay": "0"
                  }
                ]
              }
            }
          ]
        }
      },
      "tag": "udp-noise"
    },
    {
      "tag": "loop",
      "protocol": "socks",
      "settings": {
        "servers": [
          {
            "address": "127.0.0.1",
            "port": 10810
          }
        ]
      }
    },
    {
      "tag": "dns-out",
      "protocol": "dns",
      "settings": {
        "userLevel": 1,
        "rules": [
          {
            "action": "hijack"
          }
        ]
      }
    },
    {
      "protocol": "blackhole",
      "settings": {
        "response": {
          "type": "http"
        }
      },
      "tag": "block"
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "balancers": [
      {
        "tag": "pool",
        "selector": [
          "tf-"
        ],
        "strategy": {
          "type": "random"
        }
      }
    ],
    "rules": [
      {
        "inboundTag": [
          "loop-in"
        ],
        "balancerTag": "pool"
      },
      {
        "inboundTag": [
          "tun",
          "mixed-in"
        ],
        "port": 53,
        "outboundTag": "dns-out"
      },
      {
        "inboundTag": [
          "doh-proxy"
        ],
        "balancerTag": "pool"
      },
      {
        "inboundTag": [
          "fronted-dns"
        ],
        "outboundTag": "tls-repack-dns"
      },
      {
        "inboundTag": [
          "dns"
        ],
        "outboundTag": "direct"
      },
      {
        "domain": [
          "geosite:category-ads-all"
        ],
        "outboundTag": "block"
      },
      {
        "domain": [
          "domain:ir",
          "geosite:private",
          "geosite:category-ir"
        ],
        "outboundTag": "direct"
      },
      {
        "ip": [
          "10.10.34.34/24",
          "2001:4188:2:600:10:10:34:34/112"
        ],
        "outboundTag": "block"
      },
      {
        "ip": [
          "geoip:private",
          "geoip:ir"
        ],
        "outboundTag": "direct"
      },
      {
        "network": "udp",
        "protocol": [
          "quic"
        ],
        "outboundTag": "block"
      },
      {
        "network": "udp",
        "port": 443,
        "outboundTag": "block"
      },
      {
        "network": "udp",
        "outboundTag": "udp-noise"
      },
      {
        "network": "tcp",
        "protocol": [
          "tls"
        ],
        "outboundTag": "loop"
      },
      {
        "network": "tcp",
        "port": 443,
        "outboundTag": "loop"
      },
      {
        "network": "tcp",
        "outboundTag": "direct"
      }
    ]
  },
  "stats": {},
  "fakedns": [
    {
      "ipPool": "198.18.0.0/15",
      "poolSize": 32768
    },
    {
      "ipPool": "2001:2::/48",
      "poolSize": 32768
    }
  ]
}
