{
  "remarks": "🛡️ DoH Proxy Pro + Fragment",
  "version": {
    "min": "26.6.27"
  },
  "log": {
    "loglevel": "warning",
    "dnsLog": false,
    "access": "none"
  },
  "policy": {
    "levels": {
      "0": {
        "handshake": 6,
        "connIdle": 300,
        "uplinkOnly": 2,
        "downlinkOnly": 4
      },
      "1": {
        "handshake": 6,
        "connIdle": 15,
        "uplinkOnly": 1,
        "downlinkOnly": 1
      }
    }
  },
  "dns": {
    "hosts": {
      "geosite:category-ads-all": "#3",
      "cloudflare-dns.com": "challenges.cloudflare.com",
      "${workerHost}": "challenges.cloudflare.com",
      "domain:youtube.com": "www.google.com",
      "domain:youtu.be": "www.google.com",
      "domain:ytimg.com": "www.google.com",
      "domain:ggpht.com": "www.google.com",
      "domain:youtube-nocookie.com": "www.google.com",
      "full:youtubei.googleapis.com": "www.google.com"
    },
    "servers": [
      {
        "address": "fakedns",
        "domains": [
          "domain:ir",
          "geosite:private",
          "geosite:category-ir",
          "geosite:xai",
          "geosite:openai",
          "geosite:google-deepmind",
          "geosite:anthropic",
          "geosite:github",
          "geosite:microsoft",
          "geosite:golang",
          "geosite:python",
          "geosite:rust",
          "full:challenges.cloudflare.com",
          "full:www.google.com"
        ],
        "skipFallback": true
      },
      {
        "tag": "doh-cf",
        "address": "https://cloudflare-dns.com/dns-query",
        "timeoutMs": 5000
      },
      {
        "tag": "doh-ip4",
        "address": "https://1.1.1.1/dns-query",
        "timeoutMs": 5000
      },
      {
        "tag": "doh-ip6",
        "address": "https://[2606:4700:4700::1111]/dns-query",
        "timeoutMs": 5000
      },
      {
        "tag": "doh-gg",
        "address": "https://8.8.8.8/dns-query",
        "timeoutMs": 5000
      },
      {
        "tag": "local-dns",
        "address": "localhost",
        "domains": [
          "domain:ir",
          "geosite:private",
          "geosite:category-ir",
          "geosite:xai",
          "geosite:openai",
          "geosite:google-deepmind",
          "geosite:anthropic",
          "geosite:github",
          "geosite:microsoft",
          "geosite:golang",
          "geosite:python",
          "geosite:rust",
          "full:challenges.cloudflare.com",
          "full:www.google.com"
        ],
        "timeoutMs": 8000,
        "finalQuery": true,
        "skipFallback": true
      }
    ],
    "queryStrategy": "UseIP",
    "useSystemHosts": true,
    "serveStale": true
  },
  "inbounds": [
    {
      "tag": "local-in",
      "port": 10808,
      "protocol": "mixed",
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "fakedns",
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": false
      },
      "settings": {
        "udp": true,
        "ip": "127.0.0.1"
      },
      "streamSettings": {
        "sockopt": {
          "tcpKeepAliveIdle": 60,
          "tcpKeepAliveInterval": 30
        }
      }
    }
  ],
  "outbounds": [
    {
      "tag": "reject",
      "protocol": "blackhole"
    },
    {
      "tag": "direct-tcp",
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "ForceIP",
          "happyEyeballs": {
            "tryDelayMs": 250,
            "prioritizeIPv6": false,
            "interleave": 2,
            "maxConcurrentTry": 4
          }
        }
      }
    },
    {
      "tag": "direct-udp",
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "ForceIPv4v6"
        }
      }
    },
    {
      "tag": "dns-out",
      "protocol": "dns",
      "settings": {
        "userLevel": 1
      }
    },
    {
      "tag": "fallback-auto",
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "ForceIP",
          "happyEyeballs": {
            "tryDelayMs": 200,
            "prioritizeIPv6": true,
            "interleave": 1,
            "maxConcurrentTry": 2
          }
        }
      }
    },
    {
      "tag": "tf-v6-plain",
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "ForceIP",
          "happyEyeballs": {
            "tryDelayMs": 200,
            "prioritizeIPv6": true,
            "interleave": 1,
