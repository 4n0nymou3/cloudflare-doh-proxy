      "tlsfrag-"
    ],
    "probeURL": "https://cloudflare-dns.com/dns-query",
    "probeInterval": "2m",
    "enableConcurrency": true
  },
  "burstObservatory": {
    "subjectSelector": [
      "tlsfrag-"
    ],
    "pingConfig": {
      "destination": "https://www.youtube.com/generate_204",
      "connectivity": "",
      "interval": "3m",
      "sampling": 2,
      "timeout": "9s",
      "httpMethod": "GET"
    }
  },
  "routing": {
    "domainStrategy": "IPOnDemand",
    "balancers": [
      {
        "tag": "doh-pool",
        "selector": [
          "tlsfrag-"
        ],
        "strategy": {
          "type": "leastPing"
        },
        "fallbackTag": "tlsfrag-k1"
      },
      {
        "tag": "web-pool",
        "selector": [
          "tlsfrag-"
        ],
        "strategy": {
          "type": "leastLoad",
          "settings": {
            "expected": 2,
            "maxRTT": "8s",
            "tolerance": 0.5
          }
        },
        "fallbackTag": "tlsfrag-k1"
      }
    ],
