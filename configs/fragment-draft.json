            "interleave": 1,
            "maxConcurrentTry": 2
          }
        },
        "finalmask": {
          "tcp": [
            {
              "type": "fragment",
              "settings": {
                "packets": "tlshello",
                "lengths": [
                  "40-90",
                  "1-2"
                ],
                "delays": [
                  "0"
                ],
                "maxSplit": "0"
              }
            }
          ]
        }
      }
    },
    {
