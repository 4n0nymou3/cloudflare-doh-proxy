{
  "remarks": "🛡️ DoH Proxy Pro + Fragment",
  "version": {
    "min": "26.10.10"
  },
  "log": {
    "loglevel": "warning",
    "dnsLog": false,
    "access": "none"
  },
  "policy": {
    "levels": {
      "0": {
        "handshake": 4,
        "connIdle": 300,
        "uplinkOnly": 2,
        "downlinkOnly": 4
      },
      "1": {
        "handshake": 4,
        "connIdle": 15,
        "uplinkOnly": 1,
        "downlinkOnly": 1
      }
    }
  },
  "dns": {
    "hosts": {
      "geosite:category-ads-all": "#3",
      "cloudflare-dns.com": "challenges.cloudflare.com"
    },
    "servers": [
      {
        "address": "fakedns",
        "domains": [
          "domain:ir",
          "geosite:private",
          "geosite:category-ir",
          "geosite:xai",
          "geosite:openai",
          "geosite:google-deepmind",
          "geosite:anthropic",
          "geosite:github",
          "geosite:microsoft",
          "geosite:golang",
          "geosite:python",
          "geosite:rust",
          "full:challenges.cloudflare.com"
        ]
      },
      {
        "tag": "doh-cf",
        "address": "https://cloudflare-dns.com/dns-query",
        "timeoutMs": 8000
      },
      {
        "tag": "local-dns",
        "address": "localhost",
        "domains": [
          "domain:ir",
          "geosite:private",
          "geosite:category-ir",
          "geosite:xai",
          "geosite:openai",
          "geosite:google-deepmind",
          "geosite:anthropic",
          "geosite:github",
          "geosite:microsoft",
          "geosite:golang",
          "geosite:python",
          "geosite:rust",
          "full:challenges.cloudflare.com"
        ],
        "timeoutMs": 8000,
        "finalQuery": true
      }
    ],
    "queryStrategy": "UseSystem",
    "useSystemHosts": true,
    "serveStale": true
  },
  "inbounds": [
    {
      "tag": "local-in",
      "port": 10808,
      "protocol": "mixed",
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "fakedns",
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": false
      },
      "settings": {
        "udp": true,
        "ip": "127.0.0.1"
      },
      "streamSettings": {
        "sockopt": {
          "tcpKeepAliveIdle": 60,
          "tcpKeepAliveInterval": 30
        }
      }
    }
  ],
  "outbounds": [
    {
      "tag": "reject",
      "protocol": "blackhole"
    },
    {
      "tag": "direct-tcp",
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "ForceIP",
          "happyEyeballs": {
            "tryDelayMs": 250,
            "prioritizeIPv6": true,
            "interleave": 2,
            "maxConcurrentTry": 4
          }
        }
      }
    },
    {
      "tag": "direct-udp",
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "ForceIPv4v6"
        }
      }
    },
    {
