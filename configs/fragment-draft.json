  "burstObservatory": {
    "subjectSelector": [
      "tf-"
    ],
    "pingConfig": {
      "destination": "https://www.youtube.com/generate_204",
      "connectivity": "",
      "interval": "60s",
      "sampling": 2,
      "timeout": "14s",
      "httpMethod": "GET"
    }
  },
  "routing": {
    "domainStrategy": "IPOnDemand",
    "balancers": [
      {
        "tag": "pool",
        "selector": [
          "tf-"
        ],
        "strategy": {
          "type": "leastLoad",
          "settings": {
            "expected": 1,
            "maxRTT": "14s",
            "tolerance": 0.5,
            "costs": [
              {
                "regexp": true,
                "match": "-plain$",
                "value": 1
              },
              {
                "regexp": true,
                "match": "-rec$",
                "value": 9
              },
              {
                "regexp": true,
                "match": "-rec-tcp$",
                "value": 25
              },
              {
                "regexp": true,
                "match": "-tcp-slow$",
                "value": 49
              },
              {
                "regexp": true,
                "match": "-rec-slow$",
                "value": 81
              }
            ]
          }
        },
        "fallbackTag": "fallback-auto"
      }
    ],
    "rules": [
